{
  "name": "codemize",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@expo/config-plugins": "~55.0.6",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@sentry/react-native": "~7.2.0",
    "convex": "1.31.7",
    "convex-helpers": "0.1.111",
    "expo": "~55.0.0",
    "expo-router": "~55.0.3",
    "react": "19.2.0",
    "react-native": "0.83.2"
  },
  "version": "1.0.0"
}
